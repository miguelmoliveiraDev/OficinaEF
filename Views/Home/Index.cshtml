@{
    ViewData["Title"] = "VØID — Games, Periféricos e Móveis Gamer";
    // Página independente (sem o _Layout padrão): header e footer estão aqui dentro
    Layout = null;

    // ===== CONFIGURAÇÃO DA PÁGINA =====
    // Data/hora em que o próximo drop abre (usada no relógio de contagem regressiva)
    var dropDate = new DateTimeOffset(2026, 11, 27, 0, 0, 0, TimeSpan.FromHours(-3));

    // Destino do botão "Finalizar compra" da BAG (troque pela sua rota de carrinho/checkout)
    var checkoutUrl = "#";

    // Produtos da vitrine. Quando ligar ao banco, troque este array pelo seu Model
    // (ex.: @Model.Produtos) mantendo os mesmos campos.
    // Art = arte SVG usada enquanto não houver foto. Para usar foto, troque o <svg> do card por <img>.
    var products = new[]
    {
        (Id: 101, Name: "Teclado SIGNAL 75",     Sub: "Mecânico · Switch linear",      Cat: "perifericos", Art: "keyboard", Price: 649.90m,  OldPrice: 0m,       Tag: "NOVO"),
        (Id: 102, Name: "Cadeira ABYSS",         Sub: "Couro PU · Preta e branca",     Cat: "moveis",      Art: "chair",    Price: 1899.00m, OldPrice: 2299.00m, Tag: "PROMO"),
        (Id: 103, Name: "Headset PHANTOM 7.1",   Sub: "Sem fio · Preto fosco",         Cat: "perifericos", Art: "headset",  Price: 489.90m,  OldPrice: 0m,       Tag: ""),
        (Id: 104, Name: "Mouse GHOST 8K",        Sub: "Ultraleve · 54 g",              Cat: "perifericos", Art: "mouse",    Price: 349.90m,  OldPrice: 0m,       Tag: "NOVO"),
        (Id: 105, Name: "ECLIPSE · Ed. Limitada", Sub: "Game · PC · Mídia física",     Cat: "games",       Art: "game",     Price: 299.90m,  OldPrice: 0m,       Tag: "ÚLTIMAS"),
        (Id: 106, Name: "Mesa MONOLITH 160",     Sub: "160 cm · LED dourado",          Cat: "moveis",      Art: "desk",     Price: 1499.00m, OldPrice: 0m,       Tag: "")
    };

    var br = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var fromPrice = products.Min(p => p.Price);
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="description" content="VØID — games, periféricos e móveis gamer de alto padrão. Edições limitadas, sem reposição." />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <script>document.documentElement.classList.add('js');</script>
</head>
<body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>

    @* ===== Artes SVG dos produtos (sprite) ===== *@
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <defs>
            <pattern id="keys" x="44" y="152" width="20" height="20" patternUnits="userSpaceOnUse">
                <rect x="1" y="1" width="18" height="18" rx="3.5" fill="#1d1d21" />
                <rect x="2.5" y="2" width="15" height="2" rx="1" fill="#2d2d33" />
            </pattern>
            <linearGradient id="screen" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2a0509" />
                <stop offset="1" stop-color="#0b0203" />
            </linearGradient>
        </defs>

        <!-- Teclado -->
        <symbol id="art-keyboard" viewBox="0 0 300 400">
            <ellipse cx="150" cy="292" rx="122" ry="9" fill="#000" opacity=".35" />
            <rect x="30" y="138" width="240" height="140" rx="14" fill="#0c0c0e" stroke="#303036" stroke-width="1.5" />
            <rect x="44" y="152" width="200" height="80" fill="url(#keys)" />
            <rect x="44" y="152" width="18" height="18" rx="3.5" fill="#f2efed" />
            <rect x="204" y="172" width="38" height="18" rx="3.5" fill="#d9a441" />
            <rect x="44" y="236" width="34" height="18" rx="3.5" fill="#1d1d21" />
            <rect x="82" y="236" width="104" height="18" rx="3.5" fill="#1d1d21" />
            <rect x="190" y="236" width="54" height="18" rx="3.5" fill="#1d1d21" />
            <circle cx="257" cy="168" r="10" fill="#26262b" stroke="#d9a441" stroke-width="2" />
            <rect x="253" y="162" width="8" height="2.5" rx="1" fill="#d9a441" />
            <rect x="34" y="270" width="232" height="3" rx="1.5" fill="#ff4a55" />
        </symbol>

        <!-- Cadeira -->
        <symbol id="art-chair" viewBox="0 0 300 400">
            <ellipse cx="150" cy="372" rx="100" ry="8" fill="#000" opacity=".3" />
            <g stroke="#0c0c0e" stroke-width="8" stroke-linecap="round" fill="none">
                <path d="M150 326 L66 350 M150 326 L234 350 M150 326 L108 364 M150 326 L192 364" />
            </g>
            <g fill="#17171a" stroke="#34343a" stroke-width="1.5">
                <circle cx="66" cy="354" r="8" /><circle cx="234" cy="354" r="8" /><circle cx="108" cy="368" r="8" /><circle cx="192" cy="368" r="8" />
            </g>
            <rect x="143" y="284" width="14" height="46" fill="#1d1d21" />
            <path d="M88 266 Q150 248 212 266 L220 292 Q150 312 80 292 Z" fill="#101012" stroke="#34343a" stroke-width="1.5" />
            <rect x="60" y="194" width="30" height="12" rx="6" fill="#101012" stroke="#34343a" stroke-width="1.5" />
            <rect x="68" y="204" width="14" height="62" rx="5" fill="#0c0c0e" />
            <rect x="210" y="194" width="30" height="12" rx="6" fill="#101012" stroke="#34343a" stroke-width="1.5" />
            <rect x="218" y="204" width="14" height="62" rx="5" fill="#0c0c0e" />
            <path d="M102 84 Q150 66 198 84 L226 122 L216 264 Q150 280 84 264 L74 122 Z" fill="#0f0f11" stroke="#3a3a40" stroke-width="1.5" />
            <path d="M126 102 L174 102 L170 252 L130 252 Z" fill="#f2efed" />
            <path d="M126 102 L130 252 M174 102 L170 252" stroke="#d9a441" stroke-width="2" fill="none" stroke-dasharray="5 4" />
            <rect x="118" y="34" width="64" height="38" rx="16" fill="#0f0f11" stroke="#d9a441" stroke-width="2" />
            <path d="M92 130 L110 150 M208 130 L190 150" stroke="#d9a441" stroke-width="2" stroke-linecap="round" />
        </symbol>

        <!-- Headset -->
        <symbol id="art-headset" viewBox="0 0 300 400">
            <ellipse cx="150" cy="332" rx="100" ry="8" fill="#000" opacity=".3" />
            <path d="M84 196 C84 78 216 78 216 196" fill="none" stroke="#0c0c0e" stroke-width="14" stroke-linecap="round" />
            <path d="M96 190 C96 100 204 100 204 190" fill="none" stroke="#2a2a30" stroke-width="4" stroke-linecap="round" />
            <path d="M118 112 L182 112" stroke="#d9a441" stroke-width="3" stroke-linecap="round" />
            <rect x="56" y="168" width="52" height="98" rx="24" fill="#0c0c0e" stroke="#34343a" stroke-width="1.5" />
            <rect x="192" y="168" width="52" height="98" rx="24" fill="#0c0c0e" stroke="#34343a" stroke-width="1.5" />
            <rect x="100" y="182" width="14" height="70" rx="7" fill="#1f1f24" />
            <rect x="186" y="182" width="14" height="70" rx="7" fill="#1f1f24" />
            <circle cx="80" cy="217" r="13" fill="none" stroke="#d9a441" stroke-width="2.5" />
            <circle cx="80" cy="217" r="4" fill="#ff4a55" />
            <circle cx="220" cy="217" r="13" fill="none" stroke="#d9a441" stroke-width="2.5" />
            <circle cx="220" cy="217" r="4" fill="#ff4a55" />
            <path d="M66 262 C52 296 74 318 112 318" fill="none" stroke="#0c0c0e" stroke-width="6" stroke-linecap="round" />
            <rect x="108" y="309" width="24" height="16" rx="8" fill="#0c0c0e" stroke="#d9a441" stroke-width="2" />
        </symbol>

        <!-- Mouse -->
        <symbol id="art-mouse" viewBox="0 0 300 400">
            <ellipse cx="156" cy="350" rx="64" ry="9" fill="#000" opacity=".3" />
            <path d="M150 62 C104 62 86 108 86 170 C86 252 108 332 150 332 C192 332 214 252 214 170 C214 108 196 62 150 62 Z" fill="#f2efed" stroke="#cdc8c4" stroke-width="1.5" />
            <path d="M150 64 L150 172" stroke="#b9b4b0" stroke-width="2" />
            <path d="M88 172 Q150 194 212 172" fill="none" stroke="#b9b4b0" stroke-width="2" />
            <rect x="142" y="100" width="16" height="38" rx="8" fill="#17171a" />
            <rect x="145" y="108" width="10" height="6" rx="3" fill="#ff4a55" />
            <path d="M94 210 C96 262 112 310 130 326" fill="none" stroke="#e0121f" stroke-width="3.5" stroke-linecap="round" />
            <path d="M206 210 C204 262 188 310 170 326" fill="none" stroke="#e0121f" stroke-width="3.5" stroke-linecap="round" />
            <rect x="147" y="250" width="6" height="34" rx="2" fill="#e0121f" />
            <circle cx="150" cy="232" r="2.5" fill="#d9a441" />
        </symbol>

        <!-- Game (caixa) -->
        <symbol id="art-game" viewBox="0 0 300 400">
            <ellipse cx="156" cy="344" rx="90" ry="8" fill="#000" opacity=".35" />
            <rect x="72" y="70" width="14" height="262" fill="#1c1c20" />
            <rect x="84" y="70" width="148" height="262" rx="3" fill="#0a0a0b" stroke="#3c3c42" stroke-width="1.5" />
            <rect x="84" y="70" width="148" height="20" fill="#e0121f" />
            <text x="94" y="84" font-family="'Space Grotesk',Arial,sans-serif" font-size="8" font-weight="700" letter-spacing="2" fill="#fff">VØID · PC</text>
            <circle cx="158" cy="176" r="62" fill="none" stroke="#f2efed" stroke-opacity=".25" stroke-width="1" />
            <circle cx="158" cy="176" r="46" fill="#d9a441" />
            <circle cx="170" cy="170" r="43" fill="#0a0a0b" />
            <path d="M118 176 H198" stroke="#f3d58a" stroke-width="1" opacity=".6" />
            <text x="158" y="262" text-anchor="middle" font-family="'Bebas Neue',Impact,sans-serif" font-size="40" letter-spacing="5" fill="#f2efed">ECLIPSE</text>
            <text x="158" y="280" text-anchor="middle" font-family="'Space Grotesk',Arial,sans-serif" font-size="8" font-weight="700" letter-spacing="3" fill="#d9a441">EDIÇÃO LIMITADA</text>
            <rect x="204" y="304" width="20" height="16" fill="#f2efed" />
            <text x="214" y="316" text-anchor="middle" font-family="'Space Grotesk',Arial,sans-serif" font-size="10" font-weight="700" fill="#0a0a0b">16</text>
        </symbol>

        <!-- Mesa -->
        <symbol id="art-desk" viewBox="0 0 300 400">
            <ellipse cx="150" cy="352" rx="120" ry="8" fill="#000" opacity=".3" />
            <rect x="96" y="112" width="108" height="72" rx="4" fill="#0a0a0b" stroke="#3c3c42" stroke-width="1.5" />
            <rect x="101" y="117" width="98" height="58" fill="url(#screen)" />
            <path d="M101 160 L199 160" stroke="#d9a441" stroke-width="1.2" />
            <circle cx="150" cy="150" r="14" fill="#000" stroke="#ff4a55" stroke-width="2" />
            <rect x="143" y="184" width="14" height="22" fill="#17171a" />
            <rect x="128" y="204" width="44" height="5" rx="2.5" fill="#17171a" />
            <rect x="110" y="212" width="80" height="8" rx="2" fill="#1d1d21" stroke="#34343a" />
            <ellipse cx="216" cy="216" rx="7" ry="5" fill="#f2efed" />
            <rect x="28" y="222" width="244" height="16" rx="3" fill="#101012" stroke="#34343a" stroke-width="1.5" />
            <rect x="32" y="240" width="236" height="3" fill="#f3d58a" />
            <rect x="32" y="240" width="236" height="10" fill="#d9a441" opacity=".18" />
            <rect x="50" y="240" width="12" height="104" fill="#0c0c0e" stroke="#2a2a30" />
            <rect x="238" y="240" width="12" height="104" fill="#0c0c0e" stroke="#2a2a30" />
            <rect x="38" y="342" width="36" height="7" rx="3" fill="#0c0c0e" />
            <rect x="226" y="342" width="36" height="7" rx="3" fill="#0c0c0e" />
            <rect x="62" y="276" width="176" height="6" rx="2" fill="#17171a" />
        </symbol>
    </svg>

    @* ===== HEADER ===== *@
    <header class="site-header" id="top">
        <a class="logo" href="~/" aria-label="VØID — início">
            <span>V</span><span class="logo__o">Ø</span><i class="logo__bar"></i><span>D</span>
        </a>

        <nav class="nav" id="menu" aria-label="Principal">
            <a class="nav__link" href="#vitrine" data-filter="todos">Loja</a>

            <div class="nav__item">
                <button class="nav__btn" type="button" aria-haspopup="true">Categorias <span class="nav__caret" aria-hidden="true"></span></button>
                <div class="submenu">
                    <ul class="submenu__box">
                        <li><a href="#vitrine" data-filter="games">Games <small>Jogos e edições</small></a></li>
                        <li><a href="#vitrine" data-filter="perifericos">Periféricos <small>Teclado · Mouse · Áudio</small></a></li>
                        <li><a href="#vitrine" data-filter="moveis">Móveis Gamer <small>Cadeiras · Mesas</small></a></li>
                    </ul>
                </div>
            </div>

            <a class="nav__link" href="#drop">Drops / Lançamentos</a>
            <a class="nav__link nav__live" href="#drop"><span class="dot" aria-hidden="true"></span> LIVE</a>
        </nav>

        <div class="hdr-right">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="acct" asp-area="Identity" asp-page="/Account/Manage/Index" title="Meu perfil">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>
                    <span>Perfil</span>
                </a>
                <form class="acct-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")" method="post">
                    <button class="acct" type="submit" title="Sair"><span style="display:inline">Sair</span></button>
                </form>
            }
            else
            {
                <a class="acct" asp-area="Identity" asp-page="/Account/Login" title="Entrar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>
                    <span>Entrar</span>
                </a>
            }

            <button class="bag-btn" id="bag-btn" type="button" aria-expanded="false" aria-controls="bag" aria-label="Abrir sacola">
                BAG (<span data-bag-count>0</span>)
            </button>
            <button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    @* ===== BAG (dropdown do carrinho) ===== *@
    <div class="bag-overlay" id="bag-overlay"></div>
    <aside class="bag" id="bag" aria-label="Sacola de compras" aria-hidden="true">
        <div class="bag__head">
            <h2 class="bag__title">SUA BAG <small>(<span data-bag-count>0</span>)</small></h2>
            <button class="icon-btn" type="button" data-bag-close aria-label="Fechar sacola">&times;</button>
        </div>
        <div class="bag__list" id="bag-list"></div>
        <div class="bag__foot">
            <div class="bag__sum"><span>Subtotal</span><strong id="bag-total">R$ 0,00</strong></div>
            <a class="cta cta--red cta--block" id="bag-checkout" href="@checkoutUrl">Finalizar compra <span class="arr">↗</span></a>
            <button class="cta cta--ghost cta--block" type="button" data-bag-close>Continuar comprando</button>
            <p class="bag__note">Frete e cupons calculados no checkout · Parcele em até 12x</p>
        </div>
    </aside>

    <main id="conteudo">

        @* ===== HERO ===== *@
        <section class="hero" aria-labelledby="hero-title">
            <div class="hero__art" aria-hidden="true">
                <div class="hero__photo"></div>
                <div class="hero__wordmark"><span>V</span><span>Ø</span><i></i><span>D</span></div>
                <div class="void">
                    <div class="void__glow"></div>
                    <div class="void__core"></div>
                    <div class="void__ring"></div>
                    <div class="void__orbit"></div>
                    <div class="void__slash"></div>
                    <span class="hud hud--a">Sinal // 01</span>
                    <span class="hud hud--b">● Sem reposição</span>
                    <span class="hud hud--c">Drop 01</span>
                </div>
            </div>

            <div class="hero__grid">
                <div class="hero__main">
                    <p class="eyebrow eyebrow--red"><span class="dot"></span> Nova temporada · S26</p>
                    <h1 class="hero__title" id="hero-title"><span>Dentro</span><span>do</span><span>Vazio</span></h1>
                    <div class="hero__rule"></div>
                    <p class="hero__lead">Games, periféricos e móveis gamer de alto padrão. Edições limitadas, feitas para quem joga no silêncio — e vence no barulho.</p>
                    <div class="hero__actions">
                        <a class="cta cta--red" href="#vitrine">Explorar a loja <span class="arr">↗</span></a>
                        <a class="cta cta--ghost" href="#drop">Ver o drop</a>
                    </div>

                    <div class="countdown" data-countdown="@dropDate.ToUnixTimeMilliseconds()" role="timer" aria-label="Tempo até o próximo drop">
                        <span class="countdown__label" data-cd-label>O drop abre em</span>
                        <div class="cd"><b data-cd="d">00</b><small>Dias</small></div>
                        <div class="cd"><b data-cd="h">00</b><small>Hrs</small></div>
                        <div class="cd"><b data-cd="m">00</b><small>Min</small></div>
                        <div class="cd"><b data-cd="s">00</b><small>Seg</small></div>
                    </div>
                </div>

                <div class="hero__foot">
                    <dl class="stats">
                        <div class="stat"><dt>Itens</dt><dd>07</dd></div>
                        <div class="stat"><dt>Temporada</dt><dd>S26</dd></div>
                        <div class="stat"><dt>Status</dt><dd class="glow" data-drop-status>Em breve</dd></div>
                    </dl>
                    <a class="scroll-hint" href="#drop">Rolar</a>
                </div>
            </div>

            <div class="marquee" aria-hidden="true">
                <div class="marquee__track">
                    @for (var g = 0; g < 2; g++)
                    {
                        <div class="marquee__group">
                            <span>Games</span><i></i><span>Periféricos</span><i></i><span>Móveis Gamer</span><i></i><span>Dentro do vazio</span><i></i><span>Limited Drop</span><i></i><span>Sem reposição</span><i></i><span>Drop 01 — Signal</span><i></i>
                            <span>Games</span><i></i><span>Periféricos</span><i></i><span>Móveis Gamer</span><i></i><span>Dentro do vazio</span><i></i><span>Limited Drop</span><i></i><span>Sem reposição</span><i></i><span>Drop 01 — Signal</span><i></i>
                        </div>
                    }
                </div>
            </div>
        </section>

        @* ===== DROP EM DESTAQUE ===== *@
        <section class="drop" id="drop" aria-labelledby="drop-title">
            <div class="wrap drop__grid">
                <div class="drop__copy reveal">
                    <p class="eyebrow eyebrow--red">— Drop atual</p>
                    <h2 class="drop__title" id="drop-title">DROP 01<br /><span>SIGNAL</span></h2>
                    <p class="drop__text">Uma coleção construída no silêncio. Sete peças entre games, periféricos e móveis. Sem reposição. Cada uma cortada do mesmo vazio.</p>
                    <dl class="stats">
                        <div class="stat"><dt>Itens</dt><dd>07</dd></div>
                        <div class="stat"><dt>Status</dt><dd class="glow" data-drop-status>Em breve</dd></div>
                        <div class="stat"><dt>A partir de</dt><dd>@fromPrice.ToString("C2", br)</dd></div>
                    </dl>
                    <a class="cta cta--red" href="#vitrine">Ver coleção <span class="arr">↗</span></a>
                </div>

                <div class="drop__art reveal" style="--d:120ms" aria-hidden="true">
                    <span class="tag">Novo</span>
                    <div class="drop__wordmark"><span>V</span><span>Ø</span><i></i><span>D</span></div>
                    <div class="drop__caption"><span>Signal · 01</span><span>S26</span></div>
                </div>
            </div>
        </section>

        @* ===== VITRINE / NOVIDADES ===== *@
        <section class="arrivals" id="vitrine" aria-labelledby="vitrine-title">
            <div class="wrap">
                <div class="arrivals__head reveal">
                    <h2 class="section-title" id="vitrine-title">NOVIDADES</h2>
                    <a class="cta cta--ghost cta--sm" href="#vitrine" data-filter="todos">Ver tudo <span class="arr">↗</span></a>
                </div>

                <div class="filters reveal" role="group" aria-label="Filtrar por categoria">
                    <button class="chip" type="button" data-filter="todos" aria-pressed="true">Todos</button>
                    <button class="chip" type="button" data-filter="games" aria-pressed="false">Games</button>
                    <button class="chip" type="button" data-filter="perifericos" aria-pressed="false">Periféricos</button>
                    <button class="chip" type="button" data-filter="moveis" aria-pressed="false">Móveis Gamer</button>
                </div>

                <div class="grid" id="grid">
                    @for (var i = 0; i < products.Length; i++)
                    {
                        var p = products[i];
                        <article class="product reveal" style="--d:@((i % 3) * 90)ms"
                                 data-cat="@p.Cat" data-id="@p.Id" data-name="@p.Name"
                                 data-price="@p.Price.ToString("0.00", inv)" data-art="@p.Art">
                            <a class="product__media" href="#" aria-label="Ver @p.Name">
                                @if (!string.IsNullOrEmpty(p.Tag))
                                {
                                    <span class="ribbon"><span>@p.Tag</span></span>
                                }
                                <svg class="product__art" aria-hidden="true"><use href="#art-@p.Art" /></svg>
                            </a>
                            <div class="product__row">
                                <h3 class="product__name">@p.Name</h3>
                                <span class="price">
                                    @if (p.OldPrice > 0)
                                    {
                                        <s>@p.OldPrice.ToString("C2", br)</s>
                                    }
                                    @p.Price.ToString("C2", br)
                                </span>
                            </div>
                            <p class="product__sub">@p.Sub</p>
                            <button class="add" type="button" data-add>+ Adicionar à bag</button>
                        </article>
                    }
                </div>
            </div>
        </section>

        @* ===== MANIFESTO ===== *@
        <section class="manifesto" id="sobre" aria-labelledby="manifesto-title">
            <div class="wrap manifesto__grid">
                <div class="reveal">
                    <p class="eyebrow eyebrow--dark">— Sobre a VØID</p>
                    <h2 class="manifesto__title" id="manifesto-title">NÃO CRIAMOS APENAS EQUIPAMENTOS.<br />CRIAMOS A SUA EXPERIÊNCIA.</h2>
                </div>
                <div class="manifesto__side reveal" style="--d:120ms">
                    <p class="manifesto__text">O espaço entre o jogador e o jogo. Entre o ruído e o silêncio. A VØID é a camada que você não percebe — até ser a única coisa que importa. Sem excesso. Sem sobra. Só performance e a forma que ela ocupa.</p>
                    <button class="cta cta--dark" type="button" id="manifesto-open">Ler o manifesto <span class="arr">↗</span></button>
                </div>
            </div>
        </section>
    </main>

    @* ===== FOOTER ===== *@
    <footer class="footer" id="contato">
        <div class="wrap">
            <div class="footer__top">
                <div class="news reveal">
                    <h3>FIQUE POR DENTRO<br />DA VØID</h3>
                    <p>Novos drops, lançamentos silenciosos e convites raros.<br />Sem ruído. Só sinal.</p>
                    <form id="newsletter" novalidate>
                        <label class="visually-hidden" for="news-email">Seu e-mail</label>
                        <input id="news-email" type="email" name="email" placeholder="seu@@email.com" autocomplete="email" required />
                        <button type="submit">Entrar na lista</button>
                    </form>
                    <p class="news__msg" id="news-msg" role="status" aria-live="polite"></p>
                </div>
                <p class="footer__giant reveal" style="--d:100ms">Nos vemos<br />no próximo<br />drop</p>
            </div>

            <div class="footer__cols">
                <div>
                    <h4>Redes</h4>
                    <ul>
                        <li><a href="#">Instagram</a></li>
                        <li><a href="#">Discord</a></li>
                        <li><a href="#">YouTube</a></li>
                        <li><a href="#">TikTok</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Suporte</h4>
                    <ul>
                        <li><a href="#">Central de ajuda</a></li>
                        <li><a href="#">Trocas e devoluções</a></li>
                        <li><a href="#">Rastrear pedido</a></li>
                        <li><a href="#">Fale com a gente</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Pagamento</h4>
                    <div class="pay" aria-label="Formas de pagamento">
                        <span>PIX</span><span>VISA</span><span>MASTERCARD</span><span>ELO</span><span>BOLETO</span>
                    </div>
                    <p class="footer__small">Parcele em até 12x · Compra 100% segura</p>
                </div>
            </div>

            <div class="footer__bottom">
                <span>© @DateTime.Now.Year VØID. Todos os direitos reservados.</span>
                <span>Dentro do vazio.</span>
            </div>
        </div>
    </footer>

    @* ===== Manifesto (diálogo) ===== *@
    <dialog class="dialog" id="manifesto-dialog" aria-labelledby="manifesto-dialog-title">
        <div class="dialog__in">
            <button class="icon-btn dialog__x" type="button" id="manifesto-close" aria-label="Fechar">&times;</button>
            <p class="eyebrow eyebrow--red">— Manifesto</p>
            <h2 id="manifesto-dialog-title">O VAZIO<br />É O PONTO DE PARTIDA</h2>
            <ol>
                <li><div><b>Menos ruído</b>Cada peça existe por um motivo. O que não melhora o seu jogo, não entra na loja.</div></li>
                <li><div><b>Sem reposição</b>Edições limitadas, numeradas e curadas. Quando acaba, acabou — e isso é parte do valor.</div></li>
                <li><div><b>Performance primeiro</b>Teclados, mouses, headsets, cadeiras e mesas escolhidos para render horas a fio, não só para aparecer.</div></li>
                <li><div><b>Presença</b>Um setup é uma assinatura. A VØID é a que você reconhece antes de ler o nome.</div></li>
            </ol>
            <a class="cta cta--red" href="#vitrine" id="manifesto-go">Explorar a loja <span class="arr">↗</span></a>
        </div>
    </dialog>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
    (function () {
        'use strict';
        var $ = function (s, c) { return (c || document).querySelector(s); };
        var $$ = function (s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); };
        var brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

        /* ---------- header: fundo ao rolar ---------- */
        var header = $('.site-header');
        function onScroll() { header.classList.toggle('is-scrolled', window.scrollY > 24); }
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        /* ---------- menu mobile ---------- */
        var burger = $('#burger'), menu = $('#menu');
        function setMenu(open) {
            menu.classList.toggle('is-open', open);
            burger.setAttribute('aria-expanded', String(open));
            document.body.style.overflow = open ? 'hidden' : '';
        }
        burger.addEventListener('click', function () { setMenu(burger.getAttribute('aria-expanded') !== 'true'); });
        $$('a', menu).forEach(function (a) { a.addEventListener('click', function () { setMenu(false); }); });

        /* ---------- revelar ao rolar ---------- */
        var reveals = $$('.reveal');
        if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
            }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
            reveals.forEach(function (el) { io.observe(el); });
        } else {
            reveals.forEach(function (el) { el.classList.add('is-in'); });
        }

        /* ---------- contagem regressiva ---------- */
        var cd = $('[data-countdown]');
        if (cd) {
            var target = Number(cd.getAttribute('data-countdown'));
            var parts = { d: $('[data-cd="d"]'), h: $('[data-cd="h"]'), m: $('[data-cd="m"]'), s: $('[data-cd="s"]') };
            var pad = function (n) { return String(n).padStart(2, '0'); };
            var tick = function () {
                var diff = Math.max(0, target - Date.now());
                var sec = Math.floor(diff / 1000);
                parts.d.textContent = pad(Math.floor(sec / 86400));
                parts.h.textContent = pad(Math.floor(sec % 86400 / 3600));
                parts.m.textContent = pad(Math.floor(sec % 3600 / 60));
                parts.s.textContent = pad(sec % 60);
                if (diff === 0) {
                    $('[data-cd-label]').textContent = 'Drop aberto';
                    $$('[data-drop-status]').forEach(function (el) { el.textContent = 'No ar'; });
                    clearInterval(timer);
                }
            };
            var timer = setInterval(tick, 1000);
            tick();
        }

        /* ---------- filtro por categoria ---------- */
        var chips = $$('.chip'), cards = $$('.product');
        function filter(cat) {
            chips.forEach(function (c) { c.setAttribute('aria-pressed', String(c.getAttribute('data-filter') === cat)); });
            cards.forEach(function (card) {
                var show = cat === 'todos' || card.getAttribute('data-cat') === cat;
                card.hidden = !show;
                if (show) card.classList.add('is-in');
            });
        }
        $$('[data-filter]').forEach(function (el) {
            el.addEventListener('click', function () { filter(el.getAttribute('data-filter')); });
        });

        /* ---------- toast ---------- */
        var toast = $('#toast'), toastTimer;
        function say(msg) {
            toast.textContent = msg;
            toast.classList.add('is-on');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(function () { toast.classList.remove('is-on'); }, 2200);
        }

        /* ---------- BAG ---------- */
        var KEY = 'void.bag.v1';
        var items = [];
        try {
            var saved = JSON.parse(localStorage.getItem(KEY) || '[]');
            if (Array.isArray(saved)) {
                items = saved.filter(function (i) { return i && typeof i.id === 'string' && i.qty > 0 && isFinite(i.price); })
                             .map(function (i) { return { id: i.id, name: String(i.name), price: Number(i.price), art: /^[a-z]+$/.test(i.art) ? i.art : 'keyboard', qty: Math.min(99, Math.floor(i.qty)) }; });
            }
        } catch (e) { items = []; }
        function persist() { try { localStorage.setItem(KEY, JSON.stringify(items)); } catch (e) { } }

        var bag = $('#bag'), overlay = $('#bag-overlay'), bagBtn = $('#bag-btn'), list = $('#bag-list'), totalEl = $('#bag-total');
        function setBag(open) {
            bag.classList.toggle('is-open', open);
            overlay.classList.toggle('is-open', open);
            bag.setAttribute('aria-hidden', String(!open));
            bagBtn.setAttribute('aria-expanded', String(open));
            if (open) setMenu(false);
        }
        bagBtn.addEventListener('click', function () { setBag(!bag.classList.contains('is-open')); });
        overlay.addEventListener('click', function () { setBag(false); });
        $$('[data-bag-close]').forEach(function (b) { b.addEventListener('click', function () { setBag(false); }); });

        function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }

        function render() {
            var count = 0, total = 0;
            list.textContent = '';
            if (!items.length) {
                var empty = el('div', 'bag__empty');
                empty.appendChild(el('strong', null, 'Sua bag está vazia'));
                empty.appendChild(document.createTextNode('Adicione algo do vazio'));
                list.appendChild(empty);
            }
            items.forEach(function (it) {
                count += it.qty; total += it.qty * it.price;
                var row = el('div', 'bag-item');

                var art = el('div', 'bag-item__art');
                var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                var use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
                use.setAttribute('href', '#art-' + it.art);
                svg.appendChild(use); art.appendChild(svg);

                var info = el('div');
                info.appendChild(el('div', 'bag-item__name', it.name));
                info.appendChild(el('div', 'bag-item__price', brl.format(it.price)));
                var qty = el('div', 'qty');
                var minus = el('button', null, '−'); minus.type = 'button'; minus.setAttribute('aria-label', 'Diminuir quantidade');
                var out = el('output', null, String(it.qty));
                var plus = el('button', null, '+'); plus.type = 'button'; plus.setAttribute('aria-label', 'Aumentar quantidade');
                minus.addEventListener('click', function () { change(it.id, -1); });
                plus.addEventListener('click', function () { change(it.id, 1); });
                qty.appendChild(minus); qty.appendChild(out); qty.appendChild(plus);
                info.appendChild(qty);

                var rm = el('button', 'bag-item__rm', 'Remover'); rm.type = 'button';
                rm.addEventListener('click', function () { change(it.id, -999); });

                row.appendChild(art); row.appendChild(info); row.appendChild(rm);
                list.appendChild(row);
            });
            $$('[data-bag-count]').forEach(function (n) { n.textContent = String(count); });
            totalEl.textContent = brl.format(total);
            bagBtn.classList.toggle('has-items', count > 0);
            persist();
        }
        function change(id, delta) {
            items = items.map(function (i) { return i.id === id ? { id: i.id, name: i.name, price: i.price, art: i.art, qty: Math.min(99, i.qty + delta) } : i; })
                         .filter(function (i) { return i.qty > 0; });
            render();
        }
        function add(card) {
            var id = card.getAttribute('data-id');
            var found = items.filter(function (i) { return i.id === id; })[0];
            if (found) { found.qty = Math.min(99, found.qty + 1); }
            else { items.push({ id: id, name: card.getAttribute('data-name'), price: Number(card.getAttribute('data-price')), art: card.getAttribute('data-art'), qty: 1 }); }
            render();
            bagBtn.classList.remove('bump'); void bagBtn.offsetWidth; bagBtn.classList.add('bump');
        }
        $$('[data-add]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                add(btn.closest('.product'));
                btn.classList.add('is-done'); btn.textContent = '✓ Adicionado';
                say('Adicionado à bag');
                setTimeout(function () { btn.classList.remove('is-done'); btn.textContent = '+ Adicionar à bag'; }, 1400);
            });
        });
        $('#bag-checkout').addEventListener('click', function (e) {
            if (!items.length) { e.preventDefault(); say('Sua bag está vazia'); }
        });
        render();

        /* ---------- manifesto ---------- */
        var dlg = $('#manifesto-dialog');
        $('#manifesto-open').addEventListener('click', function () {
            if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.setAttribute('open', '');
        });
        function closeDlg() { if (typeof dlg.close === 'function') dlg.close(); else dlg.removeAttribute('open'); }
        $('#manifesto-close').addEventListener('click', closeDlg);
        $('#manifesto-go').addEventListener('click', closeDlg);
        dlg.addEventListener('click', function (e) { if (e.target === dlg) closeDlg(); });

        /* ---------- newsletter ---------- */
        $('#newsletter').addEventListener('submit', function (e) {
            e.preventDefault();
            var input = $('#news-email'), msg = $('#news-msg');
            if (!input.value || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(input.value)) { msg.textContent = 'Digite um e-mail válido.'; input.focus(); return; }
            // TODO: enviar para o seu endpoint (fetch POST) antes de confirmar
            msg.textContent = 'Você está na lista. Até o próximo drop.';
            input.value = '';
        });

        /* ---------- ESC fecha bag e menu ---------- */
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { setBag(false); setMenu(false); }
        });
    })();
    </script>
</body>
</html>
